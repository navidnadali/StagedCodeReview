# staged-review optional overrides (sourced by lib/common.sh after ~/.claude/.env).
# Copy to ~/.agents/scripts/staged-review/config.env (install.sh does this).
# Defaults shown; uncomment to change.
#STAGED_REVIEW_SOL_MODEL=gpt-5.6-sol
#STAGED_REVIEW_SOL_REASONING=xhigh
#STAGED_REVIEW_CODEX_BIN=codex
#STAGED_REVIEW_BLOCKING_SEVERITY=major
#STAGED_REVIEW_ATTEMPT_TIMEOUT=0
#STAGED_REVIEW_LOCK_TIMEOUT=30
#STAGED_REVIEW_PROGRESS_INTERVAL=60
#STAGED_REVIEW_FILE_MAX=122880
#STAGED_REVIEW_PACK_MAX=409600
#STAGED_REVIEW_INTENT_MAX=24576
#STAGED_REVIEW_STATE_ROOT=~/.agents/state/staged-review
#ZSTD_BIN=zstd
